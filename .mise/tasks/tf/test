#!/usr/bin/env bash
#MISE description="terraform test (plan against a mocked AWS provider) for every module and example with tests/. No AWS credentials"
#MISE depends=["tf:validate"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

status=0
for dir in terraform/modules/*/ terraform/examples/*/; do
  [[ -d "${dir}tests" ]] || continue
  echo "== ${dir}"
  terraform -chdir="$dir" test -no-color || status=1
done
exit "$status"
