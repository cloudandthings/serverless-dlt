#!/usr/bin/env bash
#MISE description="Export the pinned, hashed requirements a Lambda image installs"
#USAGE flag "--db" help="Export docker/requirements-db.lock (db_bronze image) instead of docker/requirements-api.lock"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

# No sources/outputs caching: the output depends on --db, and uv export takes under a second.
if [[ "${usage_db:-false}" == "true" ]]; then
  # The db image also carries the API's aws extra (Secrets Manager refs)
  uv export --no-dev --no-emit-project --extra aws --extra db --format requirements-txt -o docker/requirements-db.lock
else
  uv export --no-dev --no-emit-project --extra aws --format requirements-txt -o docker/requirements-api.lock
fi
