#!/usr/bin/env bash
#MISE description="Create .venv and install the library, dev tools and (optionally) Spark"
#USAGE flag "--silver" help="Also install the silver group (pyspark; tests need Java 17+)"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

args=()
if [[ "${usage_silver:-false}" == "true" ]]; then
  args+=(--group silver)
fi
uv sync ${args[@]+"${args[@]}"}
